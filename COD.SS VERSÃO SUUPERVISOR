/**

 * Registra cada abertura do painel principal.

 *

 * Cria automaticamente a aba LOG_ACESSOS se ela ainda não existir.

 *

 * Colunas:

 * A = DATA

 * B = HORA

 * C = E-MAIL

 * D = COLABORADOR

 */

function registrarAcesso_(email) {

  try {

    var ss = SpreadsheetApp.getActiveSpreadsheet();

    var sheetAcessos = ss.getSheetByName('ACESSOS');

    if (!sheetAcessos) {

      return;

    }

    var sheetLog = ss.getSheetByName('LOG_ACESSOS');

    if (!sheetLog) {

      sheetLog = ss.insertSheet('LOG_ACESSOS');

      sheetLog.getRange(1, 1, 1, 4).setValues([[

        'DATA',

        'HORA',

        'E-MAIL',

        'COLABORADOR'

      ]]);

      sheetLog.getRange(1, 1, 1, 4)

        .setFontWeight('bold');

      sheetLog.setFrozenRows(1);

    }

    var emailNormalizado = String(email || '')

      .trim()

      .toLowerCase();

    var nome = '';

    var lastRow = sheetAcessos.getLastRow();

    if (lastRow >= 2) {

      var dados = sheetAcessos

        .getRange(2, 1, lastRow - 1, 2)

        .getDisplayValues();

      for (var i = 0; i < dados.length; i++) {

        var emailAcessos = String(dados[i][0] || '')

          .trim()

          .toLowerCase();

        if (emailAcessos === emailNormalizado) {

          nome = String(dados[i][1] || '').trim();

          break;

        }

      }

    }

    var agora = new Date();

    var timezone = Session.getScriptTimeZone();

    var data = Utilities.formatDate(

      agora,

      timezone,

      'dd/MM/yyyy'

    );

    var hora = Utilities.formatDate(

      agora,

      timezone,

      'HH:mm:ss'

    );

    sheetLog.appendRow([

      data,

      hora,

      emailNormalizado,

      nome

    ]);

  } catch (erro) {

    // O registro de acesso não pode impedir a abertura do painel.

    console.error(

      'Erro ao registrar acesso: ' + erro.message

    );

  }

}

/**

 * Retorna os dados do monitoramento.

 * Somente o e-mail administrativo pode executar esta função.

 */

function getMonitoramentoData() {

  validarAdminMonitoramento_();

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var sheetAcessos = ss.getSheetByName('ACESSOS');

  var sheetLog = ss.getSheetByName('LOG_ACESSOS');

  if (!sheetAcessos) {

    throw new Error('A aba ACESSOS não foi encontrada.');

  }

  var totalAutorizados = 0;

  var autorizados = {};

  var lastRowAcessos = sheetAcessos.getLastRow();

  if (lastRowAcessos >= 2) {

    var dadosAcessos = sheetAcessos

      .getRange(2, 1, lastRowAcessos - 1, 2)

      .getDisplayValues();

    dadosAcessos.forEach(function(row) {

      var email = String(row[0] || '')

        .trim()

        .toLowerCase();

      var nome = String(row[1] || '').trim();

      if (!email) return;

      totalAutorizados++;

      autorizados[email] = {

        email: email,

        nome: nome

      };

    });

  }

  var acessosHoje = [];

  var emailsQueAcessaramHoje = {};

  if (sheetLog && sheetLog.getLastRow() >= 2) {

    var dadosLog = sheetLog

      .getRange(2, 1, sheetLog.getLastRow() - 1, 4)

      .getDisplayValues();

    var hoje = Utilities.formatDate(

      new Date(),

      Session.getScriptTimeZone(),

      'dd/MM/yyyy'

    );

    dadosLog.forEach(function(row) {

      var data = String(row[0] || '').trim();

      if (data !== hoje) return;

      var hora = String(row[1] || '').trim();

      var email = String(row[2] || '')

        .trim()

        .toLowerCase();

      var nome = String(row[3] || '').trim();

      if (!email) return;

      emailsQueAcessaramHoje[email] = true;

      acessosHoje.push({

        data: data,

        hora: hora,

        email: email,

        nome: nome

      });

    });

  }

  acessosHoje.sort(function(a, b) {

    return String(b.hora).localeCompare(String(a.hora));

  });

  var naoAcessaramHoje = [];

  Object.keys(autorizados).forEach(function(email) {

    if (!emailsQueAcessaramHoje[email]) {

      naoAcessaramHoje.push({

        email: autorizados[email].email,

        nome: autorizados[email].nome

      });

    }

  });

  naoAcessaramHoje.sort(function(a, b) {

    return String(a.nome).localeCompare(

      String(b.nome),

      'pt-BR'

    );

  });

  var ultimoAcesso = acessosHoje.length

    ? acessosHoje[0]

    : null;

  // Volume de acessos do mês atual, do dia 01 até hoje.

  var agora = new Date();

  var timezone = Session.getScriptTimeZone();

  var mesAtual = Utilities.formatDate(agora, timezone, 'MM');

  var anoAtual = Utilities.formatDate(agora, timezone, 'yyyy');

  var diaAtual = Number(Utilities.formatDate(agora, timezone, 'dd'));

  var volumePorDia = {};

  for (var dia = 1; dia <= diaAtual; dia++) {

    volumePorDia[dia] = 0;

  }

  if (sheetLog && sheetLog.getLastRow() >= 2) {

    var dadosLogMes = sheetLog

      .getRange(2, 1, sheetLog.getLastRow() - 1, 4)

      .getDisplayValues();

    dadosLogMes.forEach(function(row) {

      var dataLog = String(row[0] || '').trim();

      var partes = dataLog.split('/');

      if (partes.length !== 3) return;

      var diaLog = Number(partes[0]);

      var mesLog = String(partes[1] || '');

      var anoLog = String(partes[2] || '');

      if (mesLog !== mesAtual || anoLog !== anoAtual) return;

      if (!diaLog || diaLog < 1 || diaLog > diaAtual) return;

      volumePorDia[diaLog] = (volumePorDia[diaLog] || 0) + 1;

    });

  }

  var volumeAcessosMes = [];

  for (var diaMes = 1; diaMes <= diaAtual; diaMes++) {

    volumeAcessosMes.push({

      dia: diaMes,

      valor: volumePorDia[diaMes] || 0

    });

  }

  return {

    data: Utilities.formatDate(agora, timezone, 'dd/MM/yyyy'),

    totalAutorizados: totalAutorizados,

    acessaramHoje: Object.keys(emailsQueAcessaramHoje).length,

    naoAcessaramHoje: naoAcessaramHoje.length,

    ultimoAcesso: ultimoAcesso,

    acessosHoje: acessosHoje,

    listaNaoAcessaramHoje: naoAcessaramHoje,

    volumeAcessosMes: volumeAcessosMes

  };

}

/**

 * CHECK - PONTO POR CABEÇA

 * Lista colaboradores com mais de 45 dias de empresa e pontuação igual a zero.

 * Função de leitura: não grava nem altera dados da planilha.

 */

/** Retorna nome e nível de acesso da aba ACESSOS (A=email, B=nome, C=acesso). */
function obterUsuarioAcessoCheck_(email) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('ACESSOS');
  if (!sh) throw new Error('A aba ACESSOS não foi encontrada.');
  var last = sh.getLastRow();
  if (last < 2) throw new Error('A aba ACESSOS não possui usuários cadastrados.');
  var rows = sh.getRange(2, 1, last - 1, 3).getDisplayValues();
  var emailNormalizado = String(email || '').trim().toLowerCase();
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][0] || '').trim().toLowerCase() === emailNormalizado) {
      return {
        nome: String(rows[i][1] || '').trim(),
        acesso: String(rows[i][2] || '').trim().toUpperCase()
      };
    }
  }
  throw new Error('Seu usuário não foi encontrado na aba ACESSOS.');
}

function getCheckPpcData() {

  var emailLogado = validarAcesso_();
  var usuarioCheck = obterUsuarioAcessoCheck_(emailLogado);

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var aba = ss.getSheetByName('PPC');

  if (!aba) throw new Error('A aba "PPC" não foi encontrada.');

  var dados = aba.getDataRange().getDisplayValues();

  if (dados.length < 2) {

    return JSON.stringify({ sucesso: true, total: 0, colaboradores: [] });

  }

  function normalizar(valor) {

    return String(valor == null ? '' : valor)

      .normalize('NFD')

      .replace(/[\u0300-\u036f]/g, '')

      .toUpperCase()

      .replace(/[^A-Z0-9]/g, '');

  }

  var cabecalhos = dados[0].map(normalizar);

  function localizarColuna(opcoes) {

    for (var i = 0; i < opcoes.length; i++) {

      var indice = cabecalhos.indexOf(normalizar(opcoes[i]));

      if (indice !== -1) return indice;

    }

    return -1;

  }

  function numero(valor) {

    var texto = String(valor == null ? '' : valor).trim();

    if (!texto) return NaN;

    texto = texto.replace(/\s/g, '');

    // Formato brasileiro: 1.234,56 -> 1234.56; 8,24 -> 8.24

    if (texto.indexOf(',') !== -1) {

      texto = texto.replace(/\./g, '').replace(',', '.');

    }

    var n = Number(texto);

    return isFinite(n) ? n : NaN;

  }

  function celula(linha, indice) {

    return indice >= 0 ? String(linha[indice] == null ? '' : linha[indice]).trim() : '';

  }

  var col = {

    supervisor: localizarColuna(['NOME', 'SUPERVISOR']),

    funcionario: localizarColuna(['FUNCIONARIO', 'COLABORADOR']),

    coordenador: localizarColuna(['COORDENADOR DE CAMPO', 'COORDENADOR']),

    equipe: localizarColuna(['GERENTE DE CAMPO', 'EQUIPE', 'GERENTE']),

    diasEmpresa: localizarColuna(['DIAS DE EMPRESA', 'DIAS EMPRESA', 'TEMPO DE EMPRESA']),

    // IMPORTANTE: exige o cabeçalho PPC exato; não confunde com PONTUAÇÃO.

    ppc: localizarColuna(['PPC']),

    situacao: localizarColuna(['SITUACAO', 'STATUS'])

  };

  var faltantes = [];

  if (col.funcionario < 0) faltantes.push('FUNCIONARIO');

  if (col.diasEmpresa < 0) faltantes.push('DIAS DE EMPRESA');

  if (col.ppc < 0) faltantes.push('PPC');

  if (faltantes.length) {

    throw new Error('Na aba PPC, não encontrei estes cabeçalhos na primeira linha: ' +

      faltantes.join(', ') + '. Confira o texto dos cabeçalhos.');

  }

  var colaboradores = [];

  for (var r = 1; r < dados.length; r++) {

    var linha = dados[r];

    var funcionarioOriginal = celula(linha, col.funcionario);

    var dias = numero(linha[col.diasEmpresa]);

    var pontosPpc = numero(linha[col.ppc]);

    if (!funcionarioOriginal || !isFinite(dias) || !isFinite(pontosPpc)) continue;

    if (dias <= 45 || pontosPpc !== 0) continue;
    var perfilPpc = normalizarPerfilCheck_(usuarioCheck.acesso);
    if (!perfilPpc) throw new Error('Perfil não autorizado para o Check Ponto por Cabeça.');
    if (perfilPpc === 'SUPERVISOR' && normalizar(celula(linha, col.supervisor)) !== normalizar(usuarioCheck.nome)) continue;
    if (perfilPpc === 'COORDENADOR' && normalizar(celula(linha, col.coordenador)) !== normalizar(usuarioCheck.nome)) continue;

    var matriculaMatch = funcionarioOriginal.match(/[-–]\s*(\d+)\s*$/);

    colaboradores.push({

      supervisor: celula(linha, col.supervisor),

      funcionario: funcionarioOriginal.replace(/\s*[-–]\s*\d+\s*$/, '').trim(),

      matricula: matriculaMatch ? matriculaMatch[1] : '',

      coordenador: celula(linha, col.coordenador),

      equipe: celula(linha, col.equipe),

      diasEmpresa: dias,

      pontuacao: pontosPpc,

      situacao: celula(linha, col.situacao),

      indicador: 'Ponto por Cabeça',

      status: 'Pendente do supervisor',

      statusCheck: 'Aguardando aprovação do supervisor'

    });

  }

  colaboradores.sort(function(a, b) {

    return a.funcionario.localeCompare(b.funcionario, 'pt-BR');

  });

  return JSON.stringify({

    sucesso: true,

    total: colaboradores.length,

    colaboradores: colaboradores

  });

}


/**
 * CHECK - CARREGAMENTO COM ESCOPO HIERÁRQUICO.
 * Este endpoint é usado exclusivamente pelo HTML Check.
 * Não altera getDashboardData() nem a validação usada pelas demais páginas.
 */
function getDashboardDataForCheck() {
  var email = validarAcesso_();
  var usuario = obterUsuarioAcessoCheck_(email);
  var perfil = normalizarPerfilCheck_(usuario.acesso);
  if (!perfil) throw new Error('Seu perfil não está autorizado para os checks. Use SUPERVISOR, COORDENADOR ou DIRETOR na aba ACESSOS.');

  var payload = JSON.parse(getDashboardData());
  var raioxCompleto = Array.isArray(payload.raiox) ? payload.raiox : [];
  var nomesSupervisores = [];

  function valor(obj, opcoes) {
    if (!obj || typeof obj !== 'object') return '';
    var chaves = Object.keys(obj);
    var procuradas = opcoes.map(normalizarChaveCheck_);
    for (var i = 0; i < chaves.length; i++) {
      if (procuradas.indexOf(normalizarChaveCheck_(chaves[i])) !== -1) {
        var v = obj[chaves[i]];
        if (v !== null && v !== undefined && String(v).trim() !== '') return String(v).trim();
      }
    }
    return '';
  }
  function adicionarNome(nome) {
    var n = String(nome || '').trim();
    if (n && nomesSupervisores.map(normalizarValorCheck_).indexOf(normalizarValorCheck_(n)) === -1) nomesSupervisores.push(n);
  }
  function igual(a, b) { return normalizarValorCheck_(a) !== '' && normalizarValorCheck_(a) === normalizarValorCheck_(b); }
  function emLista(v, lista) { return lista.some(function(x) { return igual(v, x); }); }

  if (perfil === 'SUPERVISOR') {
    adicionarNome(usuario.nome);
  } else if (perfil === 'COORDENADOR') {
    raioxCompleto.forEach(function(r) {
      var coord = valor(r, ['COORDENADOR DE CAMPO', 'COORDENADOR']);
      var nome = valor(r, ['NOME', 'SUPERVISOR']);
      if (igual(coord, usuario.nome)) adicionarNome(nome);
    });
    // Fail closed: coordinator without any mapped supervisors should not receive broad data.
    if (!nomesSupervisores.length) {
      throw new Error('Não encontrei supervisores vinculados a este coordenador na coluna COORDENADOR DE CAMPO da aba RAIO X. Confira o nome cadastrado em ACESSOS.');
    }
  } else {
    raioxCompleto.forEach(function(r) { adicionarNome(valor(r, ['NOME', 'SUPERVISOR'])); });
  }

  function filtrarRegistro(registro, nomeRaioX) {
    if (perfil === 'DIRETOR') return true;
    var supervisor = valor(registro, ['SUPERVISOR', 'NOME DO SUPERVISOR', 'SUPERVISOR RESPONSAVEL', 'SUPERVISOR RESPONSÁVEL', 'RESPONSAVEL DIRETO', 'RESPONSÁVEL DIRETO']);
    var coordenador = valor(registro, ['COORDENADOR DE CAMPO', 'COORDENADOR']);
    var nome = valor(registro, ['NOME', 'COLABORADOR', 'FUNCIONARIO', 'FUNCIONÁRIO', 'CHAVE', 'NOME COMPLETO']);

    if (perfil === 'SUPERVISOR') {
      if (supervisor) return igual(supervisor, usuario.nome);
      // Algumas tabelas representam o supervisor na coluna NOME, em vez de uma coluna SUPERVISOR.
      if (nomeRaioX) return igual(nome, usuario.nome);
      return emLista(nome, nomesSupervisores);
    }
    if (coordenador && igual(coordenador, usuario.nome)) return true;
    if (supervisor && emLista(supervisor, nomesSupervisores)) return true;
    if (nomeRaioX && emLista(nome, nomesSupervisores)) return true;
    // Sem um campo que permita provar a relação hierárquica, não liberar o registro.
    return false;
  }

  payload.raiox = raioxCompleto.filter(function(r) { return filtrarRegistro(r, true); });
  payload.fotosRaioX = (Array.isArray(payload.fotosRaioX) ? payload.fotosRaioX : []).filter(function(r) {
    if (perfil === 'DIRETOR') return true;
    var nome = valor(r, ['NOME', 'COLABORADOR', 'FUNCIONARIO', 'FUNCIONÁRIO']);
    return emLista(nome, nomesSupervisores);
  });

  var chavesArray = [
    'pcc', 'tam', 'abst', 'kml', 'analiticoKml', 'acidentes', 'inspecao',
    'tratarPonto', 'bhHe', 'gpsPonto', 'analiticoGpsPonto', 'recorrencia',
    'material', 'analiticoMaterial', 'veiculosParados', 'indicadoresCidades',
    'quartil4', 'improdutiva', 'instaladosEfetivados'
  ];
  chavesArray.forEach(function(chave) {
    if (Array.isArray(payload[chave])) {
      payload[chave] = payload[chave].filter(function(r) { return filtrarRegistro(r, false); });
    }
  });

  if (payload.ranking && typeof payload.ranking === 'object') {
    ['multiskill', 'recolhimento'].forEach(function(bloco) {
      if (Array.isArray(payload.ranking[bloco])) {
        payload.ranking[bloco] = payload.ranking[bloco].filter(function(r) { return filtrarRegistro(r, false); });
      }
    });
    payload.ranking.totais = {
      multiskill: (payload.ranking.multiskill || []).length,
      recolhimento: (payload.ranking.recolhimento || []).length
    };
  }

  payload.checkAccess = {
    email: email,
    nome: usuario.nome,
    perfil: perfil,
    coordenador: perfil === 'COORDENADOR' ? usuario.nome : '',
    supervisoresPermitidos: nomesSupervisores
  };
  return JSON.stringify(payload);
}

function normalizarPerfilCheck_(perfil) {
  var p = normalizarValorCheck_(perfil);
  if (p === 'SUPERVISOR') return 'SUPERVISOR';
  if (p === 'COORDENADOR') return 'COORDENADOR';
  if (p === 'DIRETOR' || p === 'DIRETORA') return 'DIRETOR';
  return '';
}
function normalizarValorCheck_(valor) {
  return String(valor == null ? '' : valor).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');
}
function normalizarChaveCheck_(valor) {
  return normalizarValorCheck_(valor);
}
