/**

 * Lê a aba RANKING usando as colunas reais.

 *

 * MULTISKILL:

 * A = NOME

 * B = CERTIFICAÇÃO

 * C = POSIÇÃO RELATIVA

 * D = POSIÇÃO

 * E = COORDENADOR

 * F = GERENTE

 * G = MÊS

 *

 * RECOLHIMENTO:

 * I = NOME

 * J = CERTIFICAÇÃO

 * K = POSIÇÃO RELATIVA

 * L = POSIÇÃO

 * M = COORDENADOR

 * N = GERENTE

 * O = MÊS

 */

function getRankingData(sheet) {



  var lastRow = sheet.getLastRow();



  var lastCol = Math.max(

    sheet.getLastColumn(),

    15

  );





  if (lastRow < 3) {



    return {

      multiskill: [],

      recolhimento: [],

      totais: {

        multiskill: 0,

        recolhimento: 0

      },

      totaisPorMes: {}

    };



  }





  var values = sheet

    .getRange(1, 1, lastRow, lastCol)

    .getDisplayValues();





  function normalizarCabecalho(v) {



    return String(v || '')

      .normalize('NFD')

      .replace(/[\u0300-\u036f]/g, '')

      .trim()

      .toUpperCase();



  }





  function numeroDaPosicao(valor) {



    var m = String(valor || '').match(/\d+/);



    return m

      ? parseInt(m[0], 10)

      : 999999;



  }





  function normalizarMes(valor) {



    return String(valor || '').trim();



  }





  var headerRow = 1;



  var dataStart = 2;





  for (

    var r = 0;

    r < Math.min(values.length, 10);

    r++

  ) {



    var a = normalizarCabecalho(values[r][0]);

    var b = normalizarCabecalho(values[r][1]);

    var c = normalizarCabecalho(values[r][2]);



    var i = normalizarCabecalho(values[r][8]);

    var j = normalizarCabecalho(values[r][9]);

    var k = normalizarCabecalho(values[r][10]);





    if (

      (

        a === 'NOME' &&

        b === 'CERTIFICACAO' &&

        c === 'POSICAO'

      )

      ||

      (

        i === 'NOME' &&

        j === 'CERTIFICACAO' &&

        k === 'POSICAO'

      )

    ) {



      headerRow = r;



      dataStart = r + 1;



      break;



    }



  }





  function montarLista(

    colNome,

    colCert,

    colPosicao,

    colCoordenador,

    colGerente,

    colMes

  ) {



    var lista = [];





    for (

      var r = dataStart;

      r < values.length;

      r++

    ) {



      var row = values[r];



      var nome = String(

        row[colNome] || ''

      ).trim();



      var certificacao = String(

        row[colCert] || ''

      ).trim();



      var posicao = String(

        row[colPosicao] || ''

      ).trim();



      var mes = normalizarMes(

        row[colMes]

      );





      if (

        !nome ||

        !posicao ||

        numeroDaPosicao(posicao) === 999999

      ) {



        continue;



      }





      lista.push({



        nome: nome,



        certificacao: certificacao,



        posicao: posicao,



        coordenador: String(

          row[colCoordenador] || ''

        ).trim(),



        gerente: String(

          row[colGerente] || ''

        ).trim(),



        mes: mes



      });



    }





    lista.sort(function(a, b) {



      var pa = numeroDaPosicao(

        a.posicao

      );



      var pb = numeroDaPosicao(

        b.posicao

      );





      if (pa !== pb) {



        return pa - pb;



      }





      return a.nome.localeCompare(

        b.nome,

        'pt-BR'

      );



    });





    return lista;



  }





  /*

   * MULTISKILL:

   * A, B, D, E, F, G

   */

  var multiskill = montarLista(

    0,

    1,

    3,

    4,

    5,

    6

  );





  /*

   * RECOLHIMENTO:

   * I, J, L, M, N, O

   */

  var recolhimento = montarLista(

    8,

    9,

    11,

    12,

    13,

    14

  );





  var totalMultiskill =

    numeroInteiro(

      values[headerRow][3]

    );





  var totalRecolhimento =

    numeroInteiro(

      values[headerRow][11]

    );





  if (!totalMultiskill) {



    totalMultiskill =

      multiskill.length;



  }





  if (!totalRecolhimento) {



    totalRecolhimento =

      recolhimento.length;



  }





  /*

   * Totais separados por mês.

   */

  var totaisPorMes = {};





  function registrarTotaisPorMes(lista) {



    lista.forEach(function(item) {



      var mes = item.mes;



      if (!mes) return;





      if (!totaisPorMes[mes]) {



        totaisPorMes[mes] = {



          multiskill: 0,



          recolhimento: 0



        };



      }



    });



  }





  registrarTotaisPorMes(

    multiskill

  );



  registrarTotaisPorMes(

    recolhimento

  );





  /*

   * Usa o denominador existente em

   * "1º/81", "1º/30" etc.

   */

  function atualizarTotalDaLista(

    lista,

    tipo

  ) {



    lista.forEach(function(item) {



      if (!item.mes) return;





      var partes = String(

        item.posicao

      ).split('/');





      var total =

        partes.length > 1

          ? numeroInteiro(

              partes[1]

            )

          : 0;





      if (total > 0) {



        totaisPorMes[

          item.mes

        ][tipo] = Math.max(

          totaisPorMes[

            item.mes

          ][tipo],

          total

        );



      }



    });



  }





  atualizarTotalDaLista(

    multiskill,

    'multiskill'

  );



  atualizarTotalDaLista(

    recolhimento,

    'recolhimento'

  );





  /*

   * Se não houver denominador,

   * usa a quantidade de registros.

   */

  Object.keys(

    totaisPorMes

  ).forEach(function(mes) {



    if (

      !totaisPorMes[mes]

        .multiskill

    ) {



      totaisPorMes[mes]

        .multiskill =

        multiskill.filter(

          function(item) {



            return item.mes === mes;



          }

        ).length;



    }





    if (

      !totaisPorMes[mes]

        .recolhimento

    ) {



      totaisPorMes[mes]

        .recolhimento =

        recolhimento.filter(

          function(item) {



            return item.mes === mes;



          }

        ).length;



    }



  });





  return {



    multiskill: multiskill,



    recolhimento: recolhimento,



    totais: {



      multiskill:

        totalMultiskill,



      recolhimento:

        totalRecolhimento



    },



    totaisPorMes:

      totaisPorMes



  };



}





function numeroInteiro(valor) {



  var texto = String(

    valor || ''

  ).replace(/\D/g, '');





  var numero = parseInt(

    texto,

    10

  );





  return isFinite(numero)

    ? numero

    : 0;



}





/**

 * ============================================================

 * FOTOS DA RAIO X

 * ============================================================

 *

 * Cria uma lista independente das fotos.

 *

 * Essa lista NÃO possui mês.

 *

 * Portanto:

 *

 * RANKING = filtrado por mês

 * FOTO    = buscada na RAIO X completa

 *

 * Isso evita que setembro/outubro façam

 * a foto desaparecer.

 */

function getFotosRaioX(sheet) {



  var range =

    sheet.getDataRange();





  var values =

    range.getValues();





  var displayValues =

    range.getDisplayValues();





  var formulas =

    range.getFormulas();





  if (

    !values ||

    values.length < 2

  ) {



    return [];



  }





  function normalizarCabecalhoFoto_(

    valor

  ) {



    return String(

      valor || ''

    )

      .normalize('NFD')

      .replace(

        /[\u0300-\u036f]/g,

        ''

      )

      .trim()

      .toUpperCase();



  }





  function pareceUrlFoto_(

    valor

  ) {



    var texto = String(

      valor || ''

    ).trim();





    return (

      /^https?:\/\//i.test(

        texto

      )

      ||

      /^data:image\//i.test(

        texto

      )

    );



  }





  function extrairUrlFormula_(

    formula

  ) {



    var texto = String(

      formula || ''

    ).trim();





    if (!texto) {



      return '';



    }





    /*

     * Trata:

     *

     * =IMAGE("https\://...")

     */

    var match = texto.match(

      /IMAGE\s*\(\s*["']([^"']+)["'](?:\s*[,;][^)]*)?\)/i

    );





    if (

      match &&

      match[1]

    ) {



      return match[1].trim();



    }





    /*

     * Trata casos onde a URL

     * aparece diretamente.

     */

    match = texto.match(

      /IMAGE\s*\(\s*([^,;)]+)(?:\s*[,;][^)]*)?\)/i

    );





    if (

      match &&

      match[1]

    ) {



      var referencia =

        String(

          match[1]

        ).trim();





      if (

        /^https?:\/\//i.test(

          referencia

        )

      ) {



        return referencia;



      }



    }





    return '';



  }





  var headers =

    values[0];





  var nomeCol = -1;



  var fotoCols = [];





  var nomesAceitos = {



    'NOME': true,



    'NOME COMPLETO': true,



    'COLABORADOR': true,



    'FUNCIONARIO': true,



    'FUNCIONÁRIO': true



  };





  var fotosAceitas = {



    'FOTO': true,



    'FOTO 2': true,



    'FOTO2': true,



    'LINK FOTO': true,



    'URL FOTO': true,



    'URL DA FOTO': true,



    'LINK DA FOTO': true,



    'IMAGEM': true,



    'IMAGE': true,



    'PHOTO': true,



    'PICTURE': true



  };





  for (

    var c = 0;

    c < headers.length;

    c++

  ) {



    var header =

      normalizarCabecalhoFoto_(

        headers[c]

      );





    if (

      nomeCol === -1 &&

      nomesAceitos[header]

    ) {



      nomeCol = c;



    }





    if (

      fotosAceitas[header]

    ) {



      fotoCols.push(c);



    }



  }





  if (nomeCol === -1) {



    return [];



  }





  var resultado = [];





  for (

    var r = 1;

    r < values.length;

    r++

  ) {



    var nome = String(

      displayValues[r][nomeCol] ||

      values[r][nomeCol] ||

      ''

    ).trim();





    if (!nome) {



      continue;



    }





    var foto = '';





    /*

     * Procura a foto nas colunas

     * identificadas.

     */

    for (

      var f = 0;

      f < fotoCols.length;

      f++

    ) {



      var col =

        fotoCols[f];





      var valorDisplay =

        String(

          displayValues[r][col] ||

          ''

        ).trim();





      var valorRaw =

        String(

          values[r][col] ||

          ''

        ).trim();





      var valorFormula =

        String(

          formulas[r][col] ||

          ''

        ).trim();





      if (

        pareceUrlFoto_(

          valorDisplay

        )

      ) {



        foto =

          valorDisplay;



        break;



      }





      if (

        pareceUrlFoto_(

          valorRaw

        )

      ) {



        foto =

          valorRaw;



        break;



      }





      var urlFormula =

        extrairUrlFormula_(

          valorFormula

        );





      if (urlFormula) {



        foto =

          urlFormula;



        break;



      }



    }





    resultado.push({



      nome: nome,



      foto: foto



    });



  }





  return resultado;



}





/**

 * Converte uma aba em Array de Objetos JSON.

 */

function getSheetData(sheet) {



  var data =

    sheet.getDataRange()

      .getValues();





  var displayData =

    sheet.getDataRange()

      .getDisplayValues();





  if (

    data.length < 2

  ) {



    return [];



  }





  var headers =

    data[0];





  var result = [];





  for (

    var i = 1;

    i < data.length;

    i++

  ) {



    var row =

      data[i];





    var displayRow =

      displayData[i];





    var obj = {};



    var hasContent = false;





    for (

      var j = 0;

      j < headers.length;

      j++

    ) {



      var headerName =

        String(

          headers[j]

        ).trim();





      if (

        headerName !== ''

      ) {



        var rawVal =

          row[j];





        var displayVal =

          displayRow[j];





        var cellValue =

          rawVal;





        if (

          rawVal instanceof Date

        ) {



          if (

            rawVal.getFullYear() ===

            1899

          ) {



            cellValue =

              displayVal;



          } else {



            cellValue =

              Utilities.formatDate(

                rawVal,

                Session.getScriptTimeZone(),

                'yyyy-MM-dd'

              );



          }



        } else if (

          typeof rawVal === 'string' &&

          rawVal.trim() === ''

        ) {



          cellValue =

            displayVal;



        }





        obj[headerName] =

          cellValue;





        if (

          cellValue !== '' &&

          cellValue !== null &&

          cellValue !== undefined

        ) {



          hasContent =

            true;



        }



      }



    }





    if (hasContent) {



      result.push(obj);



    }



  }





  return result;



}

/**
