/**

 * PAINEL DO SUPERVISOR - Code.gs

 *

 * Esta versão mantém o restante do projeto e corrige somente a leitura

 * do bloco RANKING, respeitando a estrutura REAL da aba:

 *

 * MULTISKILL

 * A = NOME

 * B = CERTIFICAÇÃO

 * C = POSIÇÃO RELATIVA

 * D = POSIÇÃO

 * E = COORDENADOR

 * F = GERENTE

 * G = MÊS

 *

 * RECOLHIMENTO

 * I = NOME

 * J = CERTIFICAÇÃO

 * K = POSIÇÃO RELATIVA

 * L = POSIÇÃO

 * M = COORDENADOR

 * N = GERENTE

 * O = MÊS

 *

 * H é a coluna separadora entre os dois blocos.

 */



function doGet(e) {

  try {

    var pagina = e && e.parameter
      ? String(e.parameter.page || '').trim().toLowerCase()
      : '';

    // Monitoramento: somente Laíze pode acessar.
    if (pagina === 'monitoramento') {
      validarAdminMonitoramento_();

      return HtmlService.createHtmlOutputFromFile('Monitoramento')
        .setTitle('Monitoramento de Acessos')
        .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
        .addMetaTag('viewport', 'width=device-width, initial-scale=1');
    }

    // Painel principal
    var email = validarAcesso_();

    // Registra o acesso somente depois da validação.
    registrarAcesso_(email);

    return HtmlService.createHtmlOutputFromFile('Index')
      .setTitle('Painel do Supervisor - Dashboard')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
      .addMetaTag('viewport', 'width=device-width, initial-scale=1');

  } catch (erro) {

    return HtmlService.createHtmlOutput(
      criarPaginaAcessoNegado_(erro.message)
    )
      .setTitle('Acesso Restrito - Painel do Supervisor')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
      .addMetaTag('viewport', 'width=device-width, initial-scale=1');

  }

}



/**

 * Valida o usuário logado contra a aba ACESSOS.

 * A coluna A deve conter o cabeçalho EMAIL CORPORATIVO e, a partir da linha 2,

 * os e-mails autorizados.

 *

 * IMPORTANTE: usa o usuário ativo da sessão Google.

 */

function validarAcesso_() {



  var email = String(Session.getActiveUser().getEmail() || '')

    .trim()

    .toLowerCase();



  if (!email) {

    throw new Error('Não foi possível identificar sua conta Google corporativa.');

  }



  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var sheetAcessos = ss.getSheetByName('ACESSOS');



  if (!sheetAcessos) {

    throw new Error('A aba ACESSOS não foi encontrada.');

  }



  var lastRow = sheetAcessos.getLastRow();



  if (lastRow < 2) {

    throw new Error('A lista de acessos está vazia.');

  }



  var emails = sheetAcessos

    .getRange(2, 1, lastRow - 1, 1)

    .getDisplayValues();



  for (var i = 0; i < emails.length; i++) {



    var emailAutorizado = String(emails[i][0] || '')

      .trim()

      .toLowerCase();



    if (emailAutorizado && emailAutorizado === email) {

      return email;

    }



  }



  throw new Error('Seu e-mail não está autorizado para acessar este painel.');



}





